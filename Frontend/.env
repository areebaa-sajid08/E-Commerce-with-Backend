# REQUIRED on Vercel (set it in the frontend project's Environment Variables, then redeploy).
# Full URL of your deployed backend, ending in /api. Locally, leave as /api (Vite proxies it).
# Example: VITE_API_URL=https://your-backend.vercel.app/api
VITE_API_URL=https://e-commerce-backend-one-delta.vercel.app/api
# Socket.IO needs a long-running server (it does NOT work on Vercel serverless).
# Leave empty on Vercel; set only if you host the socket server elsewhere (Render, Railway, ...).
VITE_SOCKET_URL=
